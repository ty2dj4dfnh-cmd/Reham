rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test document read
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Isolated User Data: Users can only read and write their own document and subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /courses/{courseId} {
        allow read, write: if isOwner(userId) && isValidId(courseId);
      }

      match /exams/{examId} {
        allow read, write: if isOwner(userId) && isValidId(examId);
      }

      match /tasks/{taskId} {
        allow read, write: if isOwner(userId) && isValidId(taskId);
      }

      match /lectures/{lectureId} {
        allow read, write: if isOwner(userId) && isValidId(lectureId);
      }

      match /checkIns/{dateKey} {
        allow read, write: if isOwner(userId) && isValidId(dateKey);
      }

      match /achievements/{achievementId} {
        allow read, write: if isOwner(userId) && isValidId(achievementId);
      }

      match /focusReset/{dayId} {
        allow read, write: if isOwner(userId) && isValidId(dayId);
      }

      match /focusSessions/{sessionId} {
        allow read, write: if isOwner(userId) && isValidId(sessionId);
      }

      match /couldntFinish/{logId} {
        allow read, write: if isOwner(userId) && isValidId(logId);
      }

      match /dailyReviews/{reviewId} {
        allow read, write: if isOwner(userId) && isValidId(reviewId);
      }

      match /paceProfile/{docId} {
        allow read, write: if isOwner(userId) && isValidId(docId);
      }

      match /plans/{planId} {
        allow read, write: if isOwner(userId) && isValidId(planId);
      }

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
